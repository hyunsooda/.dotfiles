#!/usr/bin/env bash

# Terminate already running bar instances
killall -q polybar

# Wait up to 3s for the processes to shut down. On a screen change polybar reloads itself in place
# (screenchange-reload) and can survive the killall, so waiting forever spins the CPU.
for _ in $(seq 30); do pgrep -u $UID -x polybar >/dev/null || break; sleep 0.1; done
# Still running: it already reloaded itself, so launching another would duplicate the bar.
pgrep -u $UID -x polybar >/dev/null && exit 0

for m in $(polybar --list-monitors | cut -d":" -f1); do
	WIRELESS=$(ls /sys/class/net/ | grep ^wl | awk 'NR==1{print $1}') MONITOR=$m polybar --reload hyunsoo-bar &
done

echo "Bars launched..."
